<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2" xmlns:kml="http://www.opengis.net/kml/2.2" xmlns:atom="http://www.w3.org/2005/Atom">
<Document>
    <name>Lo Gatito Browser 😺</name>
    
    <Style id="estilo_gatito">
        <IconStyle>
            <scale>1.2</scale>
            <Icon>
                <href>https://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href>
            </Icon>
        </IconStyle>
        <BalloonStyle>
            <text><![CDATA[
<style>
    /* Reset e Caixa Geral para evitar estouro horizontal */
    * {
        box-sizing: border-box;
    }
    .gatito-container {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        padding: 2px;
        width: 100%;
        max-width: 320px;
        color: #1f2937;
        overflow-x: hidden;
    }
    .gatito-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
        padding-bottom: 6px;
        border-bottom: 2px solid #2563eb;
    }
    .gatito-title {
        font-size: 15px;
        font-weight: bold;
        color: #1e3a8a;
    }
    .gatito-badge {
        font-size: 10px;
        background: #dbeafe;
        color: #1e40af;
        padding: 2px 6px;
        border-radius: 10px;
        font-weight: 600;
    }

    /* Caixa de Atualização */
    .update-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px;
        margin-bottom: 10px;
        text-align: center;
    }
    .update-label {
        font-size: 11px;
        color: #475569;
        margin-bottom: 6px;
        font-weight: bold;
    }
    .btn-check {
        background: #ffffff;
        border: 1px solid #cbd5e1;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 11px;
        color: #334155;
        cursor: pointer;
        font-weight: bold;
        width: 100%;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    .aviso-download {
        display: none;
        margin-top: 8px;
        padding: 8px;
        background: #fee2e2;
        border: 1px solid #fca5a5;
        border-radius: 6px;
        color: #991b1b;
        font-size: 10px;
        font-weight: 500;
        line-height: 1.3;
        text-align: left;
    }
    .release-link {
        display: flex;
        gap: 5px;
        margin-top: 8px;
    }
    .release-link input {
        min-width: 0;
        flex: 1;
        padding: 5px;
        border: 1px solid #cbd5e1;
        border-radius: 5px;
        color: #475569;
        font-size: 10px;
    }
    .btn-copy {
        border: 1px solid #2563eb;
        border-radius: 5px;
        padding: 5px 8px;
        background: #2563eb;
        color: #ffffff;
        font-size: 10px;
        font-weight: bold;
        cursor: pointer;
        white-space: nowrap;
    }

    /* Grade de 2 Colunas sem barra de rolagem interna */
    .categories-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        overflow-x: hidden;
    }
    .category-group {
        background: #fdfdfd;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 6px;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }
    .section-title {
        font-size: 10px;
        font-weight: bold;
        color: #1e40af;
        margin-bottom: 5px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 2px;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .shortcut-card {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 5px 6px;
        margin-bottom: 4px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        text-decoration: none;
        min-width: 0;
    }
    .shortcut-card:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
    }
    .shortcut-icon {
        width: 16px;
        height: 16px;
        border-radius: 3px;
        flex-shrink: 0;
    }
    .shortcut-info {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
        flex: 1;
    }
    .shortcut-title {
        font-size: 10px;
        font-weight: 600;
        color: #1f2937;
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .shortcut-desc {
        font-size: 8px;
        color: #6b7280;
        margin-top: 1px;
        line-height: 1.1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Rodapé e Créditos do Repositório */
    .gatito-footer {
        margin-top: 10px;
        padding-top: 8px;
        border-top: 1px solid #e5e7eb;
        display: flex;
        justify-content: center;
    }
    .btn-credits {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 5px 10px;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        text-decoration: none;
        color: #334155;
        font-size: 9px;
        font-weight: bold;
        width: 100%;
        box-sizing: border-box;
    }
    .btn-credits:active, .btn-credits:hover {
        background: #e2e8f0;
    }
    .icon-credits {
        width: 12px;
        height: 12px;
    }
</style>

<div class="gatito-container">
    <div class="gatito-header">
        <div class="gatito-title">
            <span>😺</span> <span>Lo Gatito Browser</span>
        </div>
        <span class="gatito-badge" id="badge-versao">v2.0.4</span>
    </div>

    <!-- Interface de Verificação (GitHub API) -->
    <div class="update-box">
        <div id="status-label" class="update-label">Verificar se há atualizações</div>
        
        <button id="btn-verificar" class="btn-check" onclick="consultarGitHub()">
            🔄 Buscar Atualizações
        </button>

        <div id="aviso-download" class="aviso-download">
            ⚠️ <b>Nova atualização disponível.</b> Copie o link abaixo e envie pelo WhatsApp ou outro aplicativo. Abra-o em um navegador, em outro dispositivo, para baixar o novo arquivo KML. Depois, importe o arquivo no Google Earth, pois o download não pode ser feito diretamente por ele.
            <div class="release-link">
                <input id="link-release" type="text" readonly="readonly" value="" />
                <button id="btn-copiar" class="btn-copy" onclick="copiarLinkRelease()">Copiar link</button>
            </div>
        </div>
    </div>

    <!-- Grade de 2 Colunas livre de rolagem interna -->
    <div class="categories-grid">
        
        <!-- Categoria 1: Estudos -->
        <div class="category-group">
            <div class="section-title">📚 Estudos</div>

            <a href="https://ankiweb.net" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=ankiweb.net&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">AnkiWeb</span>
                    <span class="shortcut-desc">Flashcards</span>
                </div>
            </a>

            <a href="https://questoes.grancursosonline.com.br/aluno/filtro/concursos" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=grancursosonline.com.br&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">GranQuestões</span>
                    <span class="shortcut-desc">Concursos</span>
                </div>
            </a>

            <a href="https://www.qconcursos.com/questoes-de-concursos/questoes" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=qconcursos.com&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">QConcursos</span>
                    <span class="shortcut-desc">Provas</span>
                </div>
            </a>

            <a href="https://encecapacitacao.ibge.gov.br/ev/my/" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=ibge.gov.br&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">Treinamento IBGE</span>
                    <span class="shortcut-desc">Capacitação</span>
                </div>
            </a>

            <a href="https://eadcnh.bsa.estaleiro.serpro.gov.br/home?curso=673a6cc7e3bb091c6db844aa" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=serpro.gov.br&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">Curso CNH</span>
                    <span class="shortcut-desc">Aulas CNH</span>
                </div>
            </a>

            <a href="https://www.duolingo.com/learn" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=duolingo.com&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">Duolingo</span>
                    <span class="shortcut-desc">Idiomas</span>
                </div>
            </a>
        </div>


        <!-- Categoria 2: IA & Ferramentas -->
        <div class="category-group">
            <div class="section-title">🤖 IA & Ferramentas</div>

            <a href="https://gemini.google.com/" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=gemini.google.com&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">Gemini AI</span>
                    <span class="shortcut-desc">IA do Google</span>
                </div>
            </a>

            <a href="https://chatgpt.com" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=chatgpt.com&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">ChatGPT</span>
                    <span class="shortcut-desc">IA OpenAI</span>
                </div>
            </a>

            <a href="https://translate.google.com" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=translate.google.com&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">Tradutor</span>
                    <span class="shortcut-desc">Traduções</span>
                </div>
            </a>

            <a href="https://www.google.com.br" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=google.com.br&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">Google</span>
                    <span class="shortcut-desc">Pesquisas</span>
                </div>
            </a>

            <a href="https://drive.google.com/" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=drive.google.com&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">Google Drive</span>
                    <span class="shortcut-desc">Nuvem</span>
                </div>
            </a>
        </div>


        <!-- Categoria 3: Mídia & Social -->
        <div class="category-group">
            <div class="section-title">🎬 Mídia & Social</div>

            <a href="https://www.youtube.com" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=youtube.com&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">YouTube</span>
                    <span class="shortcut-desc">Vídeos</span>
                </div>
            </a>

            <a href="https://music.youtube.com" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=music.youtube.com&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">YouTube Music</span>
                    <span class="shortcut-desc">Músicas</span>
                </div>
            </a>

            <a href="https://globoplay.globo.com/" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=globoplay.globo.com&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">Globoplay</span>
                    <span class="shortcut-desc">Streaming</span>
                </div>
            </a>

            <a href="https://instagram.com" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=instagram.com&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">Instagram</span>
                    <span class="shortcut-desc">Redes sociais</span>
                </div>
            </a>
        </div>


        <!-- Categoria 4: Transporte -->
        <div class="category-group">
            <div class="section-title">🚌 Transporte</div>

            <a href="https://linhas.cittamobi.com.br/" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=cittamobi.com.br&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">Cittamobi</span>
                    <span class="shortcut-desc">Ônibus real-time</span>
                </div>
            </a>

            <a href="https://onibus.online/rn/natal/" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=onibus.online&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">Onibus Online</span>
                    <span class="shortcut-desc">Frota Natal/RN</span>
                </div>
            </a>

            <a href="https://ifood.com.br/inicio" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=ifood.com.br&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">iFood</span>
                    <span class="shortcut-desc">Delivery</span>
                </div>
            </a>

            <a href="https://www.uber.com/br/pt-br/rider-home/" target="_blank" class="shortcut-card">
                <img src="https://www.google.com/s2/favicons?domain=uber.com&amp;sz=32" class="shortcut-icon" />
                <div class="shortcut-info">
                    <span class="shortcut-title">Uber</span>
                    <span class="shortcut-desc">Viagens</span>
                </div>
            </a>
        </div>

    </div>

    <!-- Seção de Créditos e Repositório -->
    <div class="gatito-footer">
        <a href="https://github.com/alxtreme1/Lo-Gatito-Browser" target="_blank" class="btn-credits">
            <img src="https://www.google.com/s2/favicons?domain=github.com&amp;sz=32" class="icon-credits" />
            Repositório Oficial (alxtreme1/Lo-Gatito-Browser)
        </a>
    </div>

</div>

<script type="text/javascript">
    const VERSAO_ATUAL = "v2.0.4";
    const REPOSITORIO = "alxtreme1/Lo-Gatito-Browser";

    document.getElementById('badge-versao').innerText = VERSAO_ATUAL;

    // Função para comparar versões
    function isNewerVersion(latest, current) {
        const v1 = latest.replace(/[^0-9.]/g, '').split('.');
        const v2 = current.replace(/[^0-9.]/g, '').split('.');
        const len = Math.max(v1.length, v2.length);
        
        for (let i = 0; i < len; i++) {
            const num1 = parseInt(v1[i] || 0, 10);
            const num2 = parseInt(v2[i] || 0, 10);
            
            if (num1 > num2) return true;
            if (num1 < num2) return false;
        }
        return false;
    }

    async function copiarLinkRelease() {
        const campoLink = document.getElementById('link-release');
        const btnCopiar = document.getElementById('btn-copiar');

        campoLink.select();
        try {
            await navigator.clipboard.writeText(campoLink.value);
        } catch (error) {
            document.execCommand('copy');
        }
        btnCopiar.innerText = 'Copiado!';
        setTimeout(() => btnCopiar.innerText = 'Copiar link', 2000);
    }

    async function consultarGitHub() {
        const btnVerificar = document.getElementById('btn-verificar');
        const avisoDownload = document.getElementById('aviso-download');
        const label = document.getElementById('status-label');

        btnVerificar.style.display = 'none';
        label.innerText = 'Consultando API do GitHub... ⏳';
        label.style.color = '#d97706';

        try {
            const response = await fetch(`https://api.github.com/repos/${REPOSITORIO}/releases/latest`);
            
            if (!response.ok) {
                throw new Error('Erro ao checar repositório.');
            }
            
            const data = await response.json();
            const versaoMaisRecente = data.tag_name;
            const assetKml = (data.assets || []).find(asset => asset.name.toLowerCase().endsWith('.kml'));
            const linkDownload = assetKml ? assetKml.browser_download_url : data.html_url;

            if (versaoMaisRecente && isNewerVersion(versaoMaisRecente, VERSAO_ATUAL)) {
                label.innerText = `🚀 Nova versão encontrada: ${versaoMaisRecente}`;
                label.style.color = '#dc2626';
                document.getElementById('link-release').value = linkDownload;
                avisoDownload.style.display = 'block';
            } else {
                label.innerText = `✅ Você possui a versão mais recente!`;
                label.style.color = '#16a34a';
                btnVerificar.style.display = 'block';
                btnVerificar.innerText = 'Verificar Novamente';
            }
        } catch (error) {
            label.innerText = '❌ Não foi possível checar o GitHub.';
            label.style.color = '#dc2626';
            avisoDownload.innerHTML = '⚠️ <b>Erro na verificação.</b> Tente novamente mais tarde ou verifique manualmente no repositório através de outro navegador.';
            avisoDownload.style.display = 'block';
        }
    }
</script>
]]></text>
        </BalloonStyle>
    </Style>

    <Placemark>
        <name>LO GATITO (clique aqui)</name>
        <styleUrl>#estilo_gatito</styleUrl>
        <Point>
            <coordinates>-35.207871,-5.820827,0</coordinates>
        </Point>
    </Placemark>
</Document>
</kml>
